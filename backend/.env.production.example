# Production-only backend configuration. Copy this file to backend/.env.production
# on the deployment host; never copy local Supabase credentials into it.
FRONTEND_ORIGIN=https://app.example.com
UIUC_API_TIMEOUT_SECONDS=10
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_ICS_UPLOAD_BYTES=5242880
MAX_MANUAL_COURSES_PER_REQUEST=15

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_PRODUCTION_KEY_HERE
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Leave unset for hosted Supabase projects that verify JWTs through JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_HTTP_TIMEOUT_SECONDS=20
SUPABASE_SCHEDULE_ICS_BUCKET=schedule-ics
SUPABASE_SCHEDULE_ICS_PREFIX=schedule-imports
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PRODUCTION_HOST:5432/postgres
DB_SSLMODE=require

JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_SECONDS=5
JOB_RESULT_TTL_SECONDS=86400
JOB_POLL_INTERVAL_SECONDS=1
