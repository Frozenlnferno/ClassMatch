# PostgreSQL connection used by Spring JDBC.
# Use sslmode=require for hosted Supabase and sslmode=disable for local PostgreSQL.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/classmatch?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

FRONTEND_ORIGIN=http://localhost:5173