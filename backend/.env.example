FRONTEND_ORIGIN=http://localhost:5173
UIUC_API_TIMEOUT_SECONDS=10
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_ICS_UPLOAD_BYTES=5242880
MAX_MANUAL_COURSES_PER_REQUEST=15

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_YOURKEYHERE
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_HTTP_TIMEOUT_SECONDS=20
SUPABASE_SCHEDULE_ICS_BUCKET=schedule-ics
SUPABASE_SCHEDULE_ICS_PREFIX=schedule-imports
DATABASE_URL=postgresql://username:password@host:port/databaseName
DB_SSLMODE=disable # Set to "require" in production, "disable" for local dev

REDIS_URL=redis://redis:6379/0
REDIS_JOB_LEASE_SECONDS=60
REDIS_JOB_HEARTBEAT_SECONDS=20
REDIS_JOB_MAX_ATTEMPTS=3
REDIS_JOB_RETRY_BASE_DELAY_SECONDS=5
REDIS_JOB_RESULT_TTL_SECONDS=86400
REDIS_JOB_POLL_INTERVAL_SECONDS=1
