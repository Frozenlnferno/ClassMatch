FRONTEND_ORIGIN=http://localhost:5173
UIUC_API_TIMEOUT_SECONDS=10
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_ICS_UPLOAD_BYTES=5242880
MAX_MANUAL_COURSES_PER_REQUEST=15

SUPABASE_URL=http://127.0.0.1:54321
# Browser-facing URL used in public Storage links. Keep this separate from an
# internal Docker URL when running the backend in Compose.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
# Copy the local secret key from `supabase status -o env` after `supabase start`.
SUPABASE_SECRET_KEY=sb_secret_YOUR_LOCAL_KEY_HERE
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Copy JWT_SECRET from `supabase status -o env`. Used only by local HS256 tokens.
SUPABASE_JWT_SECRET=YOUR_LOCAL_JWT_SECRET_HERE
SUPABASE_HTTP_TIMEOUT_SECONDS=20
SUPABASE_SCHEDULE_ICS_BUCKET=schedule-ics
SUPABASE_SCHEDULE_ICS_PREFIX=schedule-imports
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_SSLMODE=disable

JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_SECONDS=5
JOB_RESULT_TTL_SECONDS=86400
JOB_POLL_INTERVAL_SECONDS=1
