# Docker Hub account used for production images.
DOCKERHUB_USERNAME=your-dockerhub-username

# Use the full Git commit SHA published by GitHub Actions.
RELEASE_VERSION=replace-with-commit-sha

# Public frontend build configuration.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_FRONTEND_ORIGIN=http://localhost:3000
